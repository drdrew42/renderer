{
  # Secrets for Mojolicious signed cookies. Change in production.
  secrets => ['abracadabra'],

  # --- URL Configuration ---
  # RENDERER_URL: The full public URL where this renderer is reachable.
  # Used for <base href>, JWT issuer/audience, and form action URLs.
  # Include path prefix if behind a reverse proxy at a subpath.
  # Examples:
  #   'https://render.example.com'           — direct, at root
  #   'https://example.com/renderer'         — behind proxy at /renderer
  RENDERER_URL => 'http://localhost:3000',

  # FORM_ACTION: (Optional) Where answer submission forms POST to.
  # Only needed for MITM deployments where a middleware intercepts submissions.
  # Defaults to {RENDERER_URL}/render-api when empty.
  FORM_ACTION => '',

  # --- Legacy URL Configuration (deprecated, use RENDERER_URL instead) ---
  # SITE_HOST + baseURL + formURL still work if RENDERER_URL is not set.
  # SITE_HOST => 'http://localhost:3000',
  # baseURL => '',
  # formURL => '',

  # --- JWT Secrets ---
  # problemJWT: signs/encrypts render configuration. Shared between renderer and any
  # service that creates problem tokens (e.g. an LMS integration or WW3).
  # MUST be overridden in production via env var `problemJWTsecret`.
  # Startup will refuse to run if this placeholder is still in effect.
  problemJWTsecret => 'CHANGE_ME_IN_ENV',

  # webworkJWT: encrypts session state (attempt history, scores). Used internally
  # by the renderer; shared with services that issue sessionJWTs.
  # MUST be overridden in production via env var `webworkJWTsecret`.
  webworkJWTsecret => 'CHANGE_ME_IN_ENV',

  # --- Security & Access ---
  # CORS_ORIGIN: Set to the embedding site's origin for iframe deployments.
  # '*' is convenient for development but insecure in production.
  CORS_ORIGIN => '*',

  # STRICT_JWT: entry gate. When truthy, requests that are neither JWT-bearing
  # nor peer-signed (see `peers` below / RENDERER_PEERS env var) are rejected
  # with 401. When falsy, ungrounded unsigned requests are permitted via a
  # self-minted JWT (legacy/VPC-editor posture). Peer-signed requests are
  # always admitted regardless of this setting — STRICT_JWT controls only
  # ungrounded, unsigned traffic. See WeBWorK/Renderer/Trust Model and Editor
  # Flow in the vault.
  #
  # Recommended:
  #   public/student instances                 STRICT_JWT => 1
  #   VPC-isolated editor instances            STRICT_JWT => 0 (or omit)
  #   single-deployment serving both lanes     STRICT_JWT => 1 (peers bypass)
  #
  # The answerJWT emission gate is independent and always active — self-minted
  # and peer-signed renders never produce answerJWTs.
  STRICT_JWT => 0,

  # peers: trusted peers for the peer-signed render lane. Each entry pins an
  # Ed25519 public key to a peer name. Peer-signed requests bypass JWT
  # requirements and may submit raw `problemSource` for editor/authoring flows.
  # Prefer setting via env var RENDERER_PEERS (JSON string) for cluster
  # deployments — env var overrides this config key. See
  # LibreTexts/Editor Provider Integration — Peer-Signed Render.md in the vault
  # for the signing protocol and integration spec.
  #
  # Example:
  #   peers => [
  #     { name => 'adapt-editor', public_key => 'jEA8DWhq/akvgDKbYGcVArdfndp8gC+BfplhC6Sqlxw=' },
  #     { name => 'ww3-portal',   public_key => 'a4Fz...==' },
  #   ],
  peers => [],

  # FULL_APP_INSECURE: Enables the editor UI, OPL browser, file management routes,
  # and supplemental API endpoints in production mode. These are always available
  # in development mode. NOT recommended for public-facing deployments.
  FULL_APP_INSECURE => 0,

  # --- Logging ---
  # INTERACTION_LOG: When enabled, logs each render/submit interaction to
  # logs/interactions.log with timing data.
  INTERACTION_LOG => 0,

  # STATIC_EXPIRES: Cache-Control max-age (in seconds) for static assets
  # served under /webwork2_files/. Problem-generated temp files are always
  # marked as expired regardless of this setting.
  STATIC_EXPIRES => 86400,

  # --- Hypnotoad (production server) ---
  hypnotoad => {
    listen => ['http://*:3000'],
    accepts => 400,
    workers => 10,
    spare => 5,
    clients => 100,
    graceful_timeout => 45,
    inactivity_timeout => 30,
    keep_alive_timeout => 30,
    requests => 5,
  }
};
